# 端口号
VITE_PORT=5999

VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 仅用于绑定在本机回环地址的 local 开发环境，不会进入 production 构建
VITE_DEV_LOGIN_USERNAME=admin
VITE_DEV_LOGIN_PASSWORD=Admin@123456

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
