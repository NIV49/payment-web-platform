# 应用标题
VITE_APP_TITLE=Payment Operations

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=payment-platform-admin

# Development defaults to the operations account domain. Production builds
# override this value with one of the three allowlisted deployment modes.
VITE_ACCOUNT_DOMAIN=PLATFORM

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=payment-platform-admin-local-store
