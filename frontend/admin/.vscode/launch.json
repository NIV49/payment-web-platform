{
  "$schema": "https://json.schemastore.org/launch.json",
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "name": "Payment Admin Playground",
      "request": "launch",
      "url": "http://localhost:5555",
      "env": { "NODE_ENV": "development" },
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}/playground"
    },
    {
      "type": "chrome",
      "name": "Payment Admin (Antdv Next)",
      "request": "launch",
      "url": "http://localhost:5999",
      "env": { "NODE_ENV": "development" },
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}/apps/web-antdv-next"
    }
  ]
}
